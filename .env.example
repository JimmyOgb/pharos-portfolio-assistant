# ==============================================================================
# PHAROS PORTFOLIO ASSISTANT — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# All configuration values below are strictly non-secret.
# The application is 100% read-only and requires NO private keys or credentials.
# ==============================================================================

# Primary Pharos Pacific Mainnet JSON-RPC endpoint
# Scope: Server-only (used by serverless API functions)
# Default: https://rpc.pharos.xyz
PHAROS_RPC_URL=https://rpc.pharos.xyz

# Target EVM Chain ID (Pharos Pacific Mainnet)
# Scope: Server-only (strictly asserted to be 1672)
# Default: 1672
PHAROS_CHAIN_ID=1672

# JSON-RPC request timeout in milliseconds
# Scope: Server-only
# Default: 30000
PHAROS_RPC_TIMEOUT_MS=30000

# Local server listening port (ignored in Vercel serverless execution)
# Scope: Local development only
# Default: 3000
PORT=3000

# Node.js runtime environment (production | development)
NODE_ENV=production
